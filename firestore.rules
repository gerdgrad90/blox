rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'gerdgrad9@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidHexColor(val) {
      return val is string && val.size() <= 16 && val.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidAssetKey(val) {
      return val is string && val.size() >= 1 && val.size() <= 32 && val.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Entity Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'username', 'role', 'coins', 'gems',
          'skinColor', 'torsoColor', 'legsColor', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'username', 'bio', 'role', 'coins', 'gems',
          'skinColor', 'torsoColor', 'legsColor', 'headShape',
          'hat', 'face', 'outfit', 'shirt', 'pants', 'backpack',
          'ownedItems', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.username is string
        && data.username.size() >= 3
        && data.username.size() <= 16
        && data.username.matches('^[a-zA-Z0-9_]+$')
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 80))
        && data.role == 'player'
        && data.coins is int
        && data.coins >= 0
        && data.coins <= 10000000
        && data.gems is int
        && data.gems >= 0
        && data.gems <= 1000000
        && isValidHexColor(data.skinColor)
        && isValidHexColor(data.torsoColor)
        && isValidHexColor(data.legsColor)
        && (!('headShape' in data) || (data.headShape is string && data.headShape in ['round', 'blocky']))
        && (!('hat' in data) || isValidAssetKey(data.hat))
        && (!('face' in data) || isValidAssetKey(data.face))
        && (!('outfit' in data) || isValidAssetKey(data.outfit))
        && (!('shirt' in data) || isValidAssetKey(data.shirt))
        && (!('pants' in data) || isValidAssetKey(data.pants))
        && (!('backpack' in data) || isValidAssetKey(data.backpack))
        && (!('ownedItems' in data) || (
          data.ownedItems is list &&
          data.ownedItems.size() <= 50 &&
          (data.ownedItems.size() == 0 || data.ownedItems[0] is string)
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 3. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().role == existing().role
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'username', 'bio', 'coins', 'gems',
              'skinColor', 'torsoColor', 'legsColor', 'headShape',
              'hat', 'face', 'outfit', 'shirt', 'pants', 'backpack',
              'ownedItems', 'updatedAt'
            ])
          ) || isAdmin()
        );

      allow delete: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());

      // PII Split Subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && docId == 'info' && isOwner(userId);
        allow list: if false;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && existsAfter(/databases/$(database)/documents/users/$(userId))
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(docId)
          && docId == 'info'
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'email', 'displayName', 'updatedAt'
          ]);

        allow delete: if isVerified() && isValidId(userId) && isValidId(docId) && docId == 'info' && isOwner(userId);
      }
    }
  }
}
